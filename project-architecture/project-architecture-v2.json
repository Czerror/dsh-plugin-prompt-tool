  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "Cordis 加载 Plugin Runtime；app/workbench 通过官方 slots 承载浮层与设置页。",
        "app/workspace 组合五页；data 提供 typed bridge、状态 facade 与纯保存逻辑。"
      ]
    },
    {
      "dot": "emerald",
      "title": "配置与扩展",
      "items": [
        "features 按 prompts、tools、subagents、skills、presets、characters 归位，跨领域组合只在 app。",
        "ui 只保留 props/callback 交互；标准控件复用 DSH primitives，样式使用 CSS Modules 与 --dsw-* token。",
        "preset.yml 仍统一承载 params、model、promptConfigs、variables、customTools。"
      ]
    },
    {
      "dot": "rose",
      "title": "引擎与验证",
      "items": [
        "prompt-config-engine 接线六个官方注入层；context-gate 等模块共享晋升语义。",
        "类型检查、lint、Node 回归与 CSS 所有权测试共同锁定重构边界。"
      ]
    }
