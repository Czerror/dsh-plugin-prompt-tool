  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "DSH 通过 Cordis apply() 加载 Plugin Runtime；客户端由官方 SlotRegistry 承载。",
        "工作台的业务读写经 loopback bridge，标准开关仍走 SettingsScope。",
        "重建后的 agent.cordis.yml 进入 DSH Host，最终连接 llm、tools 和 subagents。"
      ]
    },
    {
      "dot": "emerald",
      "title": "配置与持久化",
      "items": [
        "preset.yml 是单一配置源：params、model、promptConfigs、variables、customTools。",
        "manifest.ts 负责参数桥和合并优先级；write-preset.ts 物化预设目录。",
        "生成资产包括 agent.cordis.yml、prompt-configs、variables.yml、custom-tools。"
      ]
    },
    {
      "dot": "violet",
      "title": "扩展能力",
      "items": [
        "Skills provider / watcher 提供目录、缓存、排序、解析和失效通知。",
        "SillyTavern 预设、PNG/JSON 角色卡与 character_book 进入统一转换路径。",
        "character、world_book、session_var 工具在运行时注册并可触发重建。"
      ]
    },
    {
      "dot": "rose",
      "title": "引擎与工程",
      "items": [
        "prompt-config-engine 接线 pre-step、system-section、runtime-context、agent-request、llm-stream、tool-pipeline。",
        "context-gate、tool-bootstrap、code-presentation、tool-filter 等模块共享 epoch 晋升语义。",
        "package.json 脚本覆盖 build、typecheck、lint、test、同步和组合重建。"
      ]
    }
  ]
