{
  "name": "dsh-plugin-prompt-tool",
  "version": "2.1.0",
  "description": "DSH 插件：提示词工具，规范模型的思维链与回答内容，提供 Web UI 编辑 module.yml 与 AGENTS.md，并按 skills 目录注册可开关技能。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Czerror/dsh-plugin-prompt-tool.git"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "bin": {
    "prompt-tool-migrate-rules": "lib/migrate-rules.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./engine/*": "./engine/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-fs": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.0",
    "clsx": "^2.1.1",
    "lightningcss": "^1.32.0",
    "oxlint": "^1.78.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "7.8.5",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  },
  "files": [
    "lib",
    "engine",
    "cordis.patch.yml",
    "LICENSE",
    "modules",
    "skills",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "oxlint src test tsdown.config.ts",
    "test": "node scripts/run-tests.mjs",
    "sync:yaml": "node scripts/sync-yaml-vendor.mjs",
    "sync:harness": "node scripts/sync-harness-deps.mjs",
    "rebuild:module-template": "node scripts/rebuild-module-template.mjs",
    "rematerialize:modules": "node scripts/rematerialize-modules.mjs",
    "migrate:rules": "node lib/migrate-rules.mjs",
    "repair:profile": "node scripts/repair-profile.mjs",
    "verify:harness": "node scripts/sync-harness-deps.mjs --check",
    "verify:host": "node scripts/verify-host-contracts.mjs",
    "verify:pack": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@zip.js/zip.js": "2.15.0",
    "yaml": "^2.9.0"
  }
}
