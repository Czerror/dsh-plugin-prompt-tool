{
  "name": "dsh-plugin-prompt-tool",
  "version": "0.4.2",
  "description": "DSH 插件：提示词工具，规范模型的思维链与回答内容，提供 Web UI 编辑 preset.md 与 AGENTS.md，并按 skills 目录注册可开关技能。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Czerror/dsh-plugin-prompt-tool.git"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "requires": [
        "@deepseek-ai/dsh-web-app"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.0",
    "clsx": "^2.1.1",
    "lightningcss": "^1.32.0",
    "oxlint": "^1.78.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  },
  "files": [
    "lib",
    "engine",
    "cordis.patch.yml",
    "LICENSE",
    "preset",
    "templates",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "oxlint src test tsdown.config.ts",
    "test": "pnpm build && node --test \"test/**/*.test.mjs\"",
    "link:profile": "node scripts/link-profile.mjs",
    "sync:anchored": "node scripts/sync-anchored.mjs",
    "sync:yaml": "node scripts/sync-yaml-vendor.mjs",
    "rebuild:composition": "node scripts/rebuild-composition.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
