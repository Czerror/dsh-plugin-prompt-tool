{
  "name": "dsh-plugin-prompt-tool",
  "version": "0.1.0",
  "description": "DSH 插件：提示词工具，规范模型的思维链与回答内容，强制使用简体中文，并提供 Web UI 编辑 prompt.md。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Czerror/dsh-plugin-prompt-tool"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "clsx": "^2.1.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "preset",
    "vendor/dsh-anchored-standard/preset",
    "prompt",
    "prompt.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  }
}
